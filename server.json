{
	"$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
	"name": "io.github.nolindnaidoo/decisionlint",
	"title": "DecisionLint",
	"description": "Lint questions for Jev, Luna and any decision-model platform, or ask the model with your key.",
	"websiteUrl": "https://letools.dev/tools/decisionlint",
	"icons": [
		{
			"src": "https://raw.githubusercontent.com/nolindnaidoo/decisionlint/main/src/assets/images/icon.png",
			"mimeType": "image/png",
			"sizes": [
				"256x256"
			]
		}
	],
	"repository": {
		"url": "https://github.com/nolindnaidoo/decisionlint",
		"source": "github"
	},
	"version": "1.0.0",
	"packages": [
		{
			"registryType": "npm",
			"registryBaseUrl": "https://registry.npmjs.org",
			"identifier": "decisionlint-mcp",
			"version": "1.0.0",
			"runtimeHint": "npx",
			"transport": {
				"type": "stdio"
			}
		}
	]
}
