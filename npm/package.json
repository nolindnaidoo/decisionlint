{
  "name": "decisionlint-le",
  "version": "1.0.0",
  "description": "Lint the questions you send to TypeSafe's Jev model and OpenAI's Decisions API (gpt-6-luna): a command line for CI and a library for the editor, with the MCP server behind --mcp. Agent hosts install decisionlint-le-mcp instead. No API key and no network calls.",
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "luna",
    "gpt-6-luna",
    "openai",
    "decisions",
    "decisions-api",
    "lunalint",
    "lint",
    "linter",
    "cli",
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "decisionlint-le",
    "nolindnaidoo",
    "letools"
  ],
  "license": "MIT",
  "author": {
    "name": "Nolin Naidoo",
    "url": "https://nolindnaidoo.com"
  },
  "homepage": "https://letools.dev/tools/decisionlint-le",
  "repository": {
    "type": "git",
    "url": "https://github.com/nolindnaidoo/decisionlint-le.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/nolindnaidoo/decisionlint-le/issues"
  },
  "type": "commonjs",
  "main": "lib.js",
  "exports": {
    ".": "./lib.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "decisionlint-le": "cli.js"
  },
  "files": [
    "cli.js",
    "lib.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
