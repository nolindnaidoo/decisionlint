{
  "name": "decisionlint",
  "version": "1.0.1",
  "description": "Lint the questions you send to a decision model, TypeSafe's Jev, OpenAI's Decisions API (gpt-6-luna) or any platform that serves one: OpenRouter, Vercel AI Gateway, LiteLLM, LLM Gateway, Eden AI, Liquid AI, llama.cpp. A command line for CI and a library for the editor, with the MCP server behind --mcp; agent hosts install decisionlint-mcp instead. No API key and no network calls.",
  "keywords": [
    "jev",
    "typesafe",
    "system-one",
    "luna",
    "gpt-6-luna",
    "openai",
    "decisions",
    "decisions-api",
    "lunalint",
    "lint",
    "linter",
    "cli",
    "mcp",
    "modelcontextprotocol",
    "model-context-protocol",
    "mcp-server",
    "ai-agent",
    "decisionlint",
    "nolindnaidoo",
    "letools",
    "openrouter",
    "vercel-ai-gateway",
    "ai-gateway",
    "litellm",
    "llm-gateway",
    "eden-ai",
    "liquid-ai",
    "llama.cpp",
    "vllm",
    "ollaya",
    "microsoft-decision-1",
    "cloudflare",
    "decision-model",
    "decision-linter"
  ],
  "license": "MIT",
  "author": {
    "name": "Nolin Naidoo",
    "url": "https://nolindnaidoo.com"
  },
  "homepage": "https://letools.dev/tools/decisionlint",
  "repository": {
    "type": "git",
    "url": "https://github.com/nolindnaidoo/decisionlint.git",
    "directory": "npm"
  },
  "bugs": {
    "url": "https://github.com/nolindnaidoo/decisionlint/issues"
  },
  "type": "commonjs",
  "main": "lib.js",
  "exports": {
    ".": "./lib.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "decisionlint": "cli.js"
  },
  "files": [
    "cli.js",
    "lib.js",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
